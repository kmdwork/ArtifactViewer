{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Read and watch HTML artifacts in the dedicated home directory.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-watch",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/ai-artifacts" },
        { "path": "$HOME/ai-artifacts/**/*" }
      ]
    }
  ]
}
