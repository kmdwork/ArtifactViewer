{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Artifact Viewer",
  "version": "0.1.0",
  "identifier": "com.mikata.artifact-viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Artifact Viewer",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https:",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data: https:",
        "style-src": "'self' 'unsafe-inline' https:",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' blob: https:"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "Browse local HTML artifacts",
    "longDescription": "Browse, search, filter, and safely preview locally stored HTML artifacts.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
